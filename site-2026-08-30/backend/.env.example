APP_NAME=AI Intelligence Hub API
APP_VERSION=0.1.0
APP_ENV=development
APP_DEBUG=false
APP_LOG_LEVEL=INFO
APP_DOCS_ENABLED=true
APP_CORS_ORIGINS=["http://localhost:3000"]
APP_TRUSTED_HOSTS=["localhost","127.0.0.1"]
APP_GZIP_MINIMUM_SIZE=1000
APP_FRONTEND_URL=http://localhost:3000
APP_BACKEND_URL=http://localhost:8000

DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/ai_hub
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT_SECONDS=30

CONTENT_INGESTION_TIMEOUT_SECONDS=15
CONTENT_INGESTION_RETRIES=3
CONTENT_INGESTION_RATE_LIMIT_PER_MINUTE=60
CONTENT_INGESTION_ENABLED_SOURCES=[]
CONTENT_INGESTION_DISABLED_SOURCES=[]
CONTENT_INGESTION_USER_AGENT=AI-Intelligence-Hub/0.1
CONTENT_INGESTION_MAXIMUM_ARTICLE_SIZE_BYTES=5242880
CONTENT_CYCLE_SECRET=change-me-in-production
PUBLISHING_MAX_CANDIDATES_PER_CYCLE=40
CONTENT_CYCLE_INTERVAL_SECONDS=900

AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=replace-me
AZURE_OPENAI_API_VERSION=replace-me
AZURE_OPENAI_DEPLOYMENT=replace-me

AZURE_STORAGE_CONNECTION_STRING=replace-me
AZURE_STORAGE_CONTAINER_NAME=ai-hub
AZURE_KEY_VAULT_URL=https://your-vault.vault.azure.net/

JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
